{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "819df9287d2041b7bef01116274fea8a",
    "m_Title": "Custom vertex stream",
    "m_Content": "Particle Systems may use custom vertex streams for UV1 and UV2 nodes.\nR value from UV1 controls the color emission intensity of the shader.\nThis gives us full control of the color and emission within the particle system.\nWith this approach you can have different emissions on each particle even if all those particles are using the same shader and the same material.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1383.0,
        "y": -59.0,
        "width": 816.0,
        "height": 100.0
    },
    "m_Group": {
        "m_Id": "cf60428e218941168c56707a7e9d5ba2"
    }
}

